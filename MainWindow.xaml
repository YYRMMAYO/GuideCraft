<Window x:Class="GuideCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GuideCraft.Views"
        Title="{DynamicResource Str.AppTitle}"
        Width="1120" Height="740"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶部标题栏（极简） ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,0" Height="52">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="✦" Foreground="White" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GuideCraft" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Content="☾"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{DynamicResource Str.TooltipTheme}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="{DynamicResource Str.TooltipSettings}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 主体：对话为主 + 侧边栏（可拖拽） ===================== -->
        <Grid Grid.Row="1">

            <!-- 布局 A：侧边栏在左 -->
            <Grid Visibility="{Binding IsLeftLayout, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="190" MaxWidth="400" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:SidebarPanel Grid.Column="0" />
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" />
                <views:ContentHost Grid.Column="2" />
            </Grid>

            <!-- 布局 B：侧边栏在右（默认） -->
            <Grid Visibility="{Binding IsRightLayout, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="190" MaxWidth="400" />
                </Grid.ColumnDefinitions>
                <views:ContentHost Grid.Column="0" />
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" />
                <views:SidebarPanel Grid.Column="2" />
            </Grid>
        </Grid>

        <!-- ===================== 设置抽屉（覆盖层，用完关闭，对话始终为主） ===================== -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2"
              Visibility="{Binding IsSettingsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 遮罩：点击关闭 -->
            <Border Background="{DynamicResource OverlayBrush}" MouseLeftButtonDown="Overlay_OnMouseLeftButtonDown" />

            <!-- 右侧抽屉面板（可拖拽宽度） -->
            <Grid HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding SettingsWidth, Mode=TwoWay}" MinWidth="380" MaxWidth="640" />
                </Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="0" Width="4" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" />
                <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <!-- 抽屉头部 -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="设置" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="✕"
                                        Command="{Binding CloseSettingsCommand}"
                                        ToolTip="关闭设置 (Esc)" />
                            </Grid>
                        </Border>
                        <!-- 设置内容（Tab 分类） -->
                        <views:SettingsPanel />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== 首次引导教程（覆盖层 + 关闭按钮可点） ===================== -->
        <Grid x:Name="WelcomeOverlay" Grid.RowSpan="2"
              Visibility="{Binding IsWelcomeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource OverlayBrush}" />
            <Border x:Name="WelcomeCard"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="20" Width="520" Padding="44,40"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsHitTestVisible="True">
                <StackPanel>
                    <TextBlock x:Name="WelcomeIconText" Text="{Binding CurrentStepIcon}"
                               FontSize="56" HorizontalAlignment="Center" />
                    <TextBlock x:Name="WelcomeTitleText" Text="{Binding CurrentStepTitle}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,8" />
                    <TextBlock x:Name="WelcomeBodyText" Text="{Binding CurrentStepText}"
                               FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="24" />
                    <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Ellipse x:Name="Dot0" Width="8" Height="8" Margin="0,0,7,0"
                                 Fill="{DynamicResource AccentBrush}" />
                        <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="0,0,7,0"
                                 Fill="{DynamicResource SecondaryTextBrush}" />
                        <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="0,0,7,0"
                                 Fill="{DynamicResource SecondaryTextBrush}" />
                        <Ellipse x:Name="Dot3" Width="8" Height="8"
                                 Fill="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource Str.Welcome.Skip}"
                                Command="{Binding CloseWelcomeCommand}"
                                Width="100" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Str.Welcome.Start}"
                                Command="{Binding CloseWelcomeCommand}"
                                Width="128" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
