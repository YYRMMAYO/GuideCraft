<Window x:Class="GuideCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuideCraft.ViewModels"
        xmlns:controls="clr-namespace:GuideCraft.Controls"
        Title="{DynamicResource Str.AppTitle}"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶部标题栏 ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="✦" Foreground="White" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GuideCraft" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="8,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource Str.AppSubtitle}" />
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 右侧操作区 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- API Key 状态 -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ApiKeyDot" Width="8" Height="8"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="ApiKeyText" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Str.ApiKeyNotSet}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Str.ApiKeySet}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- 主题切换 -->
                    <Button Style="{StaticResource IconButtonStyle}" Content="☾"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{DynamicResource Str.TooltipTheme}" Margin="0,0,4,0" />

                    <!-- 设置 -->
                    <Button Style="{StaticResource IconButtonStyle}" Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="{DynamicResource Str.TooltipSettings}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 主体（导航栏位置可切换，默认右侧） ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== 导航栏（侧边栏） ========== -->
            <Border Grid.Column="{Binding IsSidebarRight, Converter={StaticResource BoolToColumnConverter}}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Str.NewChat}"
                            Command="{Binding NewConversationCommand}"
                            Margin="0,0,0,10" />

                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation}"
                             ItemContainerStyle="{StaticResource ConversationItemStyle}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ========== 对话区 ========== -->
            <Grid Grid.Column="{Binding IsSidebarRight, Converter={StaticResource BoolToColumnConverter}, ConverterParameter=inverse}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 消息列表 + 空状态 -->
                <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}">
                    <ScrollViewer x:Name="MessagesScroller"
                                  Style="{StaticResource FlatScrollViewerStyle}"
                                  Background="Transparent"
                                  Padding="0,16,0,8">
                        <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Bubble"
                                            MaxWidth="680"
                                            CornerRadius="12"
                                            Padding="12,10"
                                            Margin="16,4"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource AiBubbleBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <controls:MarkdownView MarkdownText="{Binding Content}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource UserBubbleBackgroundBrush}" />
                                            <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态欢迎卡片 -->
                    <Border Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Background="Transparent" Padding="40" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="✦" FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource Str.EmptyTitle}"
                                       FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,12,0,8" />
                            <TextBlock Text="{DynamicResource Str.EmptySubtitle}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       LineHeight="22" FontSize="13" />
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="16,12" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.EmptyBeforeStart}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{DynamicResource Str.EmptyBeforeStartHint}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="20" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="{DynamicResource Str.EmptyExample1}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.EmptyExample2}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.EmptyExample3}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 输入区 -->
                <Grid Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />

                    <!-- 导出项目 ZIP（生成产物后显示） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,8"
                                Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource Str.ExportZip}"
                                Command="{Binding ExportZipCommand}"
                                Padding="14,7" />
                        <TextBlock Text="{DynamicResource Str.ExportHint}"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="14,10,14,10" Margin="16,0,16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InputBox"
                                     Grid.Column="0"
                                     Style="{StaticResource BaseInputStyle}"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     MaxHeight="120"
                                     Padding="4,4"
                                     FontSize="13.5"
                                     KeyDown="InputBox_OnKeyDown"
                                     ToolTip="{DynamicResource Str.InputTooltip}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Bottom" Margin="10,0,0,0">
                                <!-- 停止生成（流式时显示） -->
                                <Button x:Name="StopButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{DynamicResource Str.Stop}"
                                        Command="{Binding StopCommand}"
                                        Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,8,0" />
                                <!-- 发送 -->
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Str.Send}"
                                        Command="{Binding SendCommand}"
                                        IsEnabled="{Binding CanSend}"
                                        Padding="20,9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== 首次引导教程（覆盖层） ===================== -->
        <Border x:Name="WelcomeOverlay" Grid.RowSpan="2"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Border x:Name="WelcomeCard"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="20"
                        Width="540" Padding="44,40"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="WelcomeCardScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="WelcomeCardTranslate" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="WelcomeIconText"
                                   Text="{Binding CurrentStepIcon}"
                                   FontSize="56" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WelcomeTitleText"
                                   Text="{Binding CurrentStepTitle}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,8" />
                        <TextBlock x:Name="WelcomeBodyText"
                                   Text="{Binding CurrentStepText}"
                                   FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="24" />

                        <!-- 步骤指示点 -->
                        <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Ellipse x:Name="Dot0" Width="8" Height="8" Margin="0,0,7,0"
                                     Fill="{DynamicResource AccentBrush}" />
                            <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="0,0,7,0"
                                     Fill="{DynamicResource SecondaryTextBrush}" />
                            <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="0,0,7,0"
                                     Fill="{DynamicResource SecondaryTextBrush}" />
                            <Ellipse x:Name="Dot3" Width="8" Height="8"
                                     Fill="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource Str.Welcome.Skip}"
                                    Command="{Binding CloseWelcomeCommand}"
                                    Width="96" Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource Str.Welcome.Start}"
                                    Command="{Binding CloseWelcomeCommand}"
                                    Width="128" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
