<Window x:Class="GuideCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuideCraft.ViewModels"
        xmlns:controls="clr-namespace:GuideCraft.Controls"
        Title="GuideCraft · 引导式AI助手"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶部标题栏 ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="✦" Foreground="White" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GuideCraft" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="引导式AI助手" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="8,2,0,0" />
                </StackPanel>

                <!-- 右侧操作区 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- API Key 状态 -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="未配置 API Key" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 主题切换 -->
                    <Button Style="{StaticResource IconButtonStyle}" Content="☾"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="切换浅色/深色主题" Margin="0,0,4,0" />

                    <!-- 设置 -->
                    <Button Style="{StaticResource IconButtonStyle}" Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="设置" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 主体 ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧边栏 ========== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <!-- 新建对话 -->
                    <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButtonStyle}"
                            Content="＋ 新对话"
                            Command="{Binding NewConversationCommand}"
                            Margin="0,0,0,10" />

                    <!-- 会话列表 -->
                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation}"
                             ItemContainerStyle="{StaticResource ConversationItemStyle}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ========== 右侧对话区 ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 消息列表 + 空状态 -->
                <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}">
                    <ScrollViewer x:Name="MessagesScroller"
                                  Style="{StaticResource FlatScrollViewerStyle}"
                                  Background="Transparent"
                                  Padding="0,16,0,8">
                        <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,12,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Bubble"
                                        MaxWidth="680"
                                        CornerRadius="12"
                                        Padding="12,10"
                                        Margin="16,4"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AiBubbleBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <controls:MarkdownView MarkdownText="{Binding Content}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource UserBubbleBackgroundBrush}" />
                                        <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态欢迎卡片 -->
                    <Border Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Background="Transparent" Padding="40" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="✦" FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="欢迎使用 GuideCraft"
                                       FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,12,0,8" />
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       LineHeight="22" FontSize="13"
                                       Text="我会通过多轮提问帮你把模糊想法澄清为可执行的 Python 自动化脚本。" />
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="16,12" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="开始之前"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="20"
                                               Text="点击右上角 ⚙ 设置，配置 DeepSeek API Key 后即可开始引导式对话。" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="例如：&#x0a;· 我想做一个自动整理每天邮件的脚本&#x0a;· 帮我从 Excel 提取数据并生成报表&#x0a;· 想监控某个网站价格变化并通知我"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       LineHeight="20" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 输入区 -->
                <Grid Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />

                    <!-- 导出项目 ZIP（生成产物后显示） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,8"
                                Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="📦 导出项目 ZIP"
                                    Command="{Binding ExportZipCommand}"
                                    Padding="14,7" />
                            <TextBlock Text="生成产物后点击下载完整项目（main.py + 依赖 + README）"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="14,10,14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InputBox"
                                     Grid.Column="0"
                                     Style="{StaticResource BaseInputStyle}"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     MaxHeight="120"
                                     Padding="4,4"
                                     FontSize="13.5"
                                     KeyDown="InputBox_OnKeyDown"
                                     ToolTip="Enter 发送，Shift+Enter 换行" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Bottom" Margin="10,0,0,0">
                                <!-- 停止生成（流式时显示） -->
                                <Button x:Name="StopButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="■ 停止"
                                        Command="{Binding StopCommand}"
                                        Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,8,0" />
                                <!-- 发送 -->
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="发送 ➤"
                                        Command="{Binding SendCommand}"
                                        IsEnabled="{Binding CanSend}"
                                        Padding="20,9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
