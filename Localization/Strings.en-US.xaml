    <sys:String x:Key="Str.EmptyExample1">· I want a script that auto-organizes my daily emails</sys:String>
    <sys:String x:Key="Str.EmptyExample2">· Extract data from Excel and generate reports</sys:String>
    <sys:String x:Key="Str.EmptyExample3">· Monitor a website price change and notify me</sys:String>

