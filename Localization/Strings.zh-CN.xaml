    <sys:String x:Key="Str.Provider.Qwen">千问 Qwen（推荐 · 免费额度）</sys:String>
    <sys:String x:Key="Str.Provider.DeepSeek">DeepSeek</sys:String>
    <sys:String x:Key="Str.SettingsKeyHint.Qwen">前往阿里云百炼控制台创建 DashScope API Key（新用户有免费额度）</sys:String>
    <sys:String x:Key="Str.SettingsKeyHint.DeepSeek">前往 DeepSeek 开放平台创建 API Key（免费额度即可日常使用）</sys:String>
