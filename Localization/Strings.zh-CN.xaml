    <sys:String x:Key="Str.Chat.NeedPythonHint">需安装 Python 3.8+ 后运行</sys:String>
    <sys:String x:Key="Str.Chat.GenerateFailed">生成失败</sys:String>

    <sys:String x:Key="Str.Welcome.Title">欢迎使用 GuideCraft</sys:String>
    <sys:String x:Key="Str.Welcome.Subtitle">4 步快速上手：把你的想法变成可运行的自动化脚本</sys:String>
    <sys:String x:Key="Str.Welcome.Step1Title">配置 API Key</sys:String>
    <sys:String x:Key="Str.Welcome.Step1Text">点击右上角 ⚙ 设置，前往阿里云百炼或 DeepSeek 平台免费申请 Key</sys:String>
    <sys:String x:Key="Str.Welcome.Step2Title">描述你的想法</sys:String>
    <sys:String x:Key="Str.Welcome.Step2Text">用一句话说你想自动化什么，AI 会像顾问一样引导你逐步澄清细节</sys:String>
    <sys:String x:Key="Str.Welcome.Step3Title">确认需求摘要</sys:String>
    <sys:String x:Key="Str.Welcome.Step3Text">AI 生成结构化需求文档，确认后自动为你编写 Python 代码</sys:String>
    <sys:String x:Key="Str.Welcome.Step4Title">导出运行</sys:String>
    <sys:String x:Key="Str.Welcome.Step4Text">一键导出项目 ZIP，安装依赖后即可运行你的自动化脚本</sys:String>
    <sys:String x:Key="Str.Welcome.Start">开始使用</sys:String>
    <sys:String x:Key="Str.Welcome.Skip">跳过引导</sys:String>

    <sys:String x:Key="Str.CodeBlock.Copy">📋 复制</sys:String>
