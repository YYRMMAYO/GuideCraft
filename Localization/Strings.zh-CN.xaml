    <sys:String x:Key="Str.ExportFailed">导出失败：{error}</sys:String>

    <sys:String x:Key="Str.EmptyTitle">欢迎使用 GuideCraft</sys:String>
    <sys:String x:Key="Str.EmptySubtitle">我会通过多轮提问帮你把模糊想法澄清为可执行的 Python 自动化脚本。</sys:String>
    <sys:String x:Key="Str.EmptyBeforeStart">开始之前</sys:String>
    <sys:String x:Key="Str.EmptyBeforeStartHint">点击右上角 ⚙ 设置，配置大模型 API Key 后即可开始引导式对话。</sys:String>
    <sys:String x:Key="Str.EmptyExample1">· 我想做一个自动整理每天邮件的脚本</sys:String>
    <sys:String x:Key="Str.EmptyExample2">· 帮我从 Excel 提取数据并生成报表</sys:String>
    <sys:String x:Key="Str.EmptyExample3">· 想监控某个网站价格变化并通知我</sys:String>

