<UserControl x:Class="GuideCraft.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:GuideCraft.Utils">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Tab 条 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Models, Mode=TwoWay}">
                    <TextBlock Text="模型" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </RadioButton>
                <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Appearance, Mode=TwoWay}">
                    <TextBlock Text="外观" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </RadioButton>
                <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Language, Mode=TwoWay}">
                    <TextBlock Text="语言" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </RadioButton>
                <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Layout, Mode=TwoWay}">
                    <TextBlock Text="布局" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </RadioButton>
                <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=About, Mode=TwoWay}">
                    <TextBlock Text="关于" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ============ 内容区（按 Tab 切换） ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource FlatScrollViewerStyle}">
            <StackPanel Margin="20,18,20,24">

                <!-- ===== Tab: 模型配置 ===== -->
                <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Models, Mode=OneWay}">
                    <TextBlock Text="模型配置" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="每个配置对应一个 API 密钥，可自由创建多个" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,12" />

                    <!-- 操作行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="＋ 新增"
                                Command="{Binding NewProfileCommand}" Padding="14,6" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="编辑"
                                Command="{Binding EditProfileCommand}" Margin="8,0,0,0" Padding="14,6"
                                IsEnabled="{Binding SelectedProfile, Converter={StaticResource InverseBoolConverter}, ConverterParameter=null}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="设为默认"
                                Command="{Binding SetDefaultProfileCommand}" Margin="8,0,0,0" Padding="14,6"
                                IsEnabled="{Binding SelectedProfile, Converter={StaticResource InverseBoolConverter}, ConverterParameter=null}" />
                        <Button Style="{StaticResource DangerButtonStyle}" Content="删除"
                                Command="{Binding DeleteProfileCommand}" Margin="8,0,0,0" Padding="14,6"
                                IsEnabled="{Binding SelectedProfile, Converter={StaticResource InverseBoolConverter}, ConverterParameter=null}" />
                    </StackPanel>

                    <!-- 配置列表 -->
                    <ListBox ItemsSource="{Binding ProfilesList}"
                             SelectedItem="{Binding SelectedProfile}"
                             ItemContainerStyle="{StaticResource ConversationItemStyle}"
                             Background="{DynamicResource CardBackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             MaxHeight="180"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6"
                                                Padding="5,1" Margin="6,0,0,0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="默认" FontSize="9" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ModelId}" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 编辑表单（新增/编辑时显示） -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,12,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                             Style="{StaticResource BaseInputStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="提供方" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ProviderPresets}" SelectedItem="{Binding EditProvider}"
                                              MinHeight="32" VerticalContentAlignment="Center"
                                              Background="{DynamicResource InputBackgroundBrush}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,5" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Base URL（OpenAI 兼容端点）" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding EditBaseUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                     Style="{StaticResource BaseInputStyle}" />

                            <TextBlock Text="模型 ID" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding EditModelId, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                     Style="{StaticResource BaseInputStyle}" />
                            <TextBlock Text="{Binding ModelPresetHint}" FontSize="11"
                                       Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="API Key（留空保留原值）" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                            <PasswordBox utils:PasswordBoxHelper.BindPassword="True"
                                         utils:PasswordBoxHelper.BoundPassword="{Binding EditApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="500" Style="{StaticResource BasePasswordStyle}" />

                            <WrapPanel Margin="0,12,0,0">
                                <CheckBox Content="设为默认配置" IsChecked="{Binding EditIsDefault}"
                                          Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <CheckBox Content="启用缓存（显示命中率与费用）" IsChecked="{Binding EditEnableCache}"
                                          Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="20,0,0,0" />
                            </WrapPanel>

                            <TextBlock Text="备注" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                     Style="{StaticResource BaseInputStyle}" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存配置"
                                        Command="{Binding SaveProfileCommand}" Width="96" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消"
                                        Command="{Binding CancelEditCommand}" Margin="8,0,0,0" Width="80" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 选中配置信息 + 测试 -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,12,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="选中配置" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="20"
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="提供方："/><Run Text="{Binding SelectedProfile.Provider}" />
                                <LineBreak />
                                <Run Text="模型："/><Run Text="{Binding SelectedProfile.ModelId}" />
                                <LineBreak />
                                <Run Text="端点："/><Run Text="{Binding SelectedProfile.BaseUrl}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding IsTesting, Converter={StaticResource TestTextConverter}, ConverterParameter=test}"
                                        Command="{Binding TestProfileCommand}"
                                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding TestResult}" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Tab: 外观 ===== -->
                <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Appearance, Mode=OneWay}">
                    <TextBlock Text="外观" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="选择界面主题" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <WrapPanel>
                            <RadioButton GroupName="ThemeTab" Content="{DynamicResource Str.SettingsThemeLight}"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Light, Mode=TwoWay}"
                                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <RadioButton GroupName="ThemeTab" Content="{DynamicResource Str.SettingsThemeDark}"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Dark, Mode=TwoWay}"
                                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Tab: 语言 ===== -->
                <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Language, Mode=OneWay}">
                    <TextBlock Text="语言 / Language" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="界面显示语言" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <WrapPanel>
                            <RadioButton GroupName="LangTab" Content="简体中文"
                                         IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=zh-CN, Mode=TwoWay}"
                                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <RadioButton GroupName="LangTab" Content="English"
                                         IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=en-US, Mode=TwoWay}"
                                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Tab: 布局 ===== -->
                <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Layout, Mode=OneWay}">
                    <TextBlock Text="布局" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="导航栏位置（侧边栏宽度可拖拽分隔条调整）" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <WrapPanel>
                            <RadioButton GroupName="LayoutTab" Content="{DynamicResource Str.SettingsSidebarLeft}"
                                         IsChecked="{Binding SelectedSidebar, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Left, Mode=TwoWay}"
                                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <RadioButton GroupName="LayoutTab" Content="{DynamicResource Str.SettingsSidebarRight}"
                                         IsChecked="{Binding SelectedSidebar, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Right, Mode=TwoWay}"
                                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Tab: 关于与更新 ===== -->
                <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=About, Mode=OneWay}">
                    <TextBlock Text="关于与更新" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="GuideCraft · 引导式AI助手" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    <TextBlock Margin="0,6,0,14" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="版本 v" /><Run Text="{Binding VersionText}" />
                    </TextBlock>
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding IsCheckingUpdate, Converter={StaticResource TestTextConverter}, ConverterParameter=update}"
                                        Command="{Binding CheckUpdateCommand}"
                                        IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="下载新版本"
                                        Command="{Binding OpenReleaseCommand}"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>