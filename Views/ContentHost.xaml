<UserControl x:Class="GuideCraft.Views.ContentHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuideCraft.Controls">
    <!-- ============ 对话区（纯净：仅消息 + 输入，v1.5 风格） ============ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 消息列表 + 空状态 -->
        <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}">
            <ScrollViewer x:Name="MessagesScroller"
                          Style="{StaticResource FlatScrollViewerStyle}"
                          Background="Transparent" Padding="0,20,0,8">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,16,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bubble"
                                    MaxWidth="720"
                                    CornerRadius="14"
                                    Padding="14,11"
                                    Margin="20,5"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AiBubbleBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Opacity="0" RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="BubbleMove" Y="8" />
                                </Border.RenderTransform>
                                <controls:MarkdownView MarkdownText="{Binding Content}" />
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetName="BubbleMove"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="8" To="0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource UserBubbleBackgroundBrush}" />
                                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态欢迎卡片 -->
            <Border Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Background="Transparent" Padding="40" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="✦" FontSize="52" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource Str.EmptyTitle}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,14,0,8" />
                    <TextBlock Text="{DynamicResource Str.EmptySubtitle}" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                               LineHeight="24" FontSize="13.5" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.EmptyBeforeStart}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Str.EmptyBeforeStartHint}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="20" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource Str.EmptyExample1}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str.EmptyExample2}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str.EmptyExample3}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 输入区 -->
        <Grid Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />

            <!-- 工具栏：导出 / 沙盒 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,14,24,8"
                        Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Str.ExportZip}"
                        Command="{Binding ExportZipCommand}" Padding="14,7" />
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Str.Sandbox.Run}"
                        Command="{Binding RunSandboxCommand}"
                        IsEnabled="{Binding CanRunSandbox}" Padding="14,7" Margin="8,0,0,0" />
                <TextBlock Text="{DynamicResource Str.ExportHint}" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- 沙盒运行结果面板 -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="24,0,24,8"
                    Visibility="{Binding HasSandboxOutput, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SandboxStatus}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding SandboxOutput}" FontSize="11.5" FontFamily="Consolas"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" MaxHeight="160" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="✕"
                            Command="{Binding ClearSandboxCommand}" ToolTip="{DynamicResource Str.Sandbox.Clear}"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14,10" Margin="24,0,24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             Style="{StaticResource BaseInputStyle}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             MaxLength="8000" MinHeight="36" Padding="4,4" FontSize="13.5"
                             KeyDown="InputBox_OnKeyDown"
                             ToolTip="{DynamicResource Str.InputTooltip}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource Str.Stop}"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Str.Send}"
                                Command="{Binding SendCommand}"
                                IsEnabled="{Binding CanSend}" Padding="22,9" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
