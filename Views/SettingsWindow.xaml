<Window x:Class="GuideCraft.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:GuideCraft.Utils"
        Title="{DynamicResource Str.SettingsTitle}"
        Width="980" Height="680"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource WindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== 左侧导航栏 ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18">
                <!-- 品牌 -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,22">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="✦" Foreground="White" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="GuideCraft" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str.SettingsNavSubtitle}" FontSize="11"
                               Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 导航项 -->
                <StackPanel>
                    <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Models, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.SettingsNavModels}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Appearance, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.SettingsNavAppearance}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Language, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.SettingsNavLanguage}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Layout, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧭" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.SettingsNavLayout}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Agent, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.SettingsNavAgent}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Stats, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.SettingsNavStats}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SettingsTabs" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=About, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.SettingsNavAbout}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,16,8,4">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,10">
                        <TextBlock Text="{DynamicResource Str.SettingsBottomTip}" FontSize="11"
                                   Foreground="{DynamicResource TertiaryTextBrush}" TextWrapping="Wrap" LineHeight="17" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== 右侧内容区 ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="26,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SettingsHeaderTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding SettingsHeaderDesc}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="✕"
                            Command="{Binding CloseWindowCommand}" ToolTip="关闭" />
                </Grid>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource FlatScrollViewerStyle}">
                <StackPanel Margin="26,20,26,28">

                    <!-- ===== Tab: 模型配置 ===== -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Models, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.SettingsModelsSectionTitle}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsModelsSectionDesc}" FontSize="11.5"
                                                   Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="＋ 新增"
                                                Command="{Binding NewProfileCommand}" Padding="14,6" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 操作行 -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="编辑"
                                            Command="{Binding EditProfileCommand}" Padding="14,6"
                                            IsEnabled="{Binding SelectedProfile, Converter={StaticResource InverseBoolConverter}, ConverterParameter=null}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="设为默认"
                                            Command="{Binding SetDefaultProfileCommand}" Margin="8,0,0,0" Padding="14,6"
                                            IsEnabled="{Binding SelectedProfile, Converter={StaticResource InverseBoolConverter}, ConverterParameter=null}" />
                                    <Button Style="{StaticResource DangerButtonStyle}" Content="删除"
                                            Command="{Binding DeleteProfileCommand}" Margin="8,0,0,0" Padding="14,6"
                                            IsEnabled="{Binding SelectedProfile, Converter={StaticResource InverseBoolConverter}, ConverterParameter=null}" />
                                </StackPanel>

                                <!-- 配置列表 -->
                                <ListBox ItemsSource="{Binding ProfilesList}"
                                         SelectedItem="{Binding SelectedProfile}"
                                         ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         MaxHeight="170"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6"
                                                            Padding="5,1" Margin="6,0,0,0"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{DynamicResource Str.SettingsDefaultBadge}" FontSize="9" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ModelId}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 编辑表单 -->
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,14" Margin="0,12,0,0"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                                         Style="{StaticResource BaseInputStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="提供方" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding ProviderPresets}" SelectedItem="{Binding EditProvider}"
                                                          MinHeight="32" VerticalContentAlignment="Center"
                                                          Background="{DynamicResource InputBackgroundBrush}"
                                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                                          BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,5" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Base URL（OpenAI 兼容端点）" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding EditBaseUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                                 Style="{StaticResource BaseInputStyle}" />

                                        <TextBlock Text="模型 ID" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding EditModelId, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                                 Style="{StaticResource BaseInputStyle}" />
                                        <TextBlock Text="{Binding ModelPresetHint}" FontSize="11"
                                                   Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,4,0,0" />

                                        <TextBlock Text="API Key（留空保留原值）" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                                        <PasswordBox utils:PasswordBoxHelper.BindPassword="True"
                                                     utils:PasswordBoxHelper.BoundPassword="{Binding EditApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="500" Style="{StaticResource BasePasswordStyle}" />

                                        <WrapPanel Margin="0,12,0,0">
                                            <CheckBox Content="{DynamicResource Str.SettingsDefaultCheck}" IsChecked="{Binding EditIsDefault}"
                                                      Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                            <CheckBox Content="{DynamicResource Str.SettingsCacheCheck}" IsChecked="{Binding EditEnableCache}"
                                                      Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="20,0,0,0" />
                                        </WrapPanel>

                                        <TextBlock Text="备注" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                                 Style="{StaticResource BaseInputStyle}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str.SettingsSaveProfile}"
                                                    Command="{Binding SaveProfileCommand}" Width="110" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str.SettingsCancel}"
                                                    Command="{Binding CancelEditCommand}" Margin="8,0,0,0" Width="80" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 选中配置信息 + 测试 -->
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,14" Margin="0,12,0,0"
                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.SettingsSelectedProfile}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="20"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="提供方："/><Run Text="{Binding SelectedProfile.Provider}" />
                                            <LineBreak />
                                            <Run Text="模型："/><Run Text="{Binding SelectedProfile.ModelId}" />
                                            <LineBreak />
                                            <Run Text="端点："/><Run Text="{Binding SelectedProfile.BaseUrl}" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding IsTesting, Converter={StaticResource TestTextConverter}, ConverterParameter=test}"
                                                    Command="{Binding TestProfileCommand}"
                                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TestResult}" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Tab: 外观 ===== -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Appearance, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.SettingsAppearanceSectionTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.SettingsAppearanceSectionDesc}" Style="{StaticResource SettingsItemDescStyle}" />

                                <Grid Style="{StaticResource SettingsItemRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.SettingsTheme}" Style="{StaticResource SettingsItemTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsThemeDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="ThemeTab" Style="{StaticResource SegmentRadioStyle}"
                                                         Content="{DynamicResource Str.SettingsThemeLight}"
                                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Light, Mode=TwoWay}" />
                                            <RadioButton GroupName="ThemeTab" Style="{StaticResource SegmentRadioStyle}"
                                                         Content="{DynamicResource Str.SettingsThemeDark}"
                                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Dark, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Tab: 语言 ===== -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Language, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.SettingsLanguageSectionTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.SettingsLanguageSectionDesc}" Style="{StaticResource SettingsItemDescStyle}" />

                                <Grid Style="{StaticResource SettingsItemRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.SettingsLanguage}" Style="{StaticResource SettingsItemTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsLanguageDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="LangTab" Style="{StaticResource SegmentRadioStyle}"
                                                         Content="简体中文"
                                                         IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=zh-CN, Mode=TwoWay}" />
                                            <RadioButton GroupName="LangTab" Style="{StaticResource SegmentRadioStyle}"
                                                         Content="English"
                                                         IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=en-US, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Tab: 布局 ===== -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Layout, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.SettingsLayoutSectionTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.SettingsLayoutSectionDesc}" Style="{StaticResource SettingsItemDescStyle}" />

                                <Grid Style="{StaticResource SettingsItemRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.SettingsSidebar}" Style="{StaticResource SettingsItemTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsSidebarDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="LayoutTab" Style="{StaticResource SegmentRadioStyle}"
                                                         Content="{DynamicResource Str.SettingsSidebarLeft}"
                                                         IsChecked="{Binding SelectedSidebar, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Left, Mode=TwoWay}" />
                                            <RadioButton GroupName="LayoutTab" Style="{StaticResource SegmentRadioStyle}"
                                                         Content="{DynamicResource Str.SettingsSidebarRight}"
                                                         IsChecked="{Binding SelectedSidebar, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Right, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Tab: Agent 行为 ===== -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Agent, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.SettingsAgentSectionTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.SettingsAgentSectionDesc}" Style="{StaticResource SettingsItemDescStyle}" />

                                <!-- 沙盒开关 -->
                                <Grid Style="{StaticResource SettingsItemRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.SettingsSandboxToggle}" Style="{StaticResource SettingsItemTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsSandboxDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding SandboxEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <!-- 沙盒超时 -->
                                <Grid Style="{StaticResource SettingsItemRowStyle}" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.SettingsSandboxTimeout}" Style="{StaticResource SettingsItemTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsSandboxTimeoutDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SandboxTimeoutOptions}"
                                              SelectedItem="{Binding SandboxTimeoutSeconds, Mode=TwoWay}"
                                              MinWidth="110" MinHeight="30" VerticalContentAlignment="Center"
                                              Background="{DynamicResource InputBackgroundBrush}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,4"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- 用量统计显示 -->
                                <Grid Style="{StaticResource SettingsItemRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.SettingsUsageToggle}" Style="{StaticResource SettingsItemTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsUsageDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding ShowUsageStats, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Tab: 用量统计 ===== -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Stats, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.SettingsStatsSectionTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsStatsSectionDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="⟳"
                                            Command="{Binding RefreshStatsCommand}" Padding="10,5"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" />
                                </StackPanel>

                                <!-- 汇总卡片 -->
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.SettingsStatsRequests}" FontSize="11"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                                            <TextBlock Text="{Binding UsageTotalsView.RequestCount}" FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Str.SettingsStatsTokens}" FontSize="11"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                                            <TextBlock FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0">
                                                <Run Text="{Binding Usage.Totals.TotalTokens, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Str.SettingsStatsCost}" FontSize="11"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                                            <TextBlock FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0">
                                                <Run Text="¥" /><Run Text="{Binding Usage.Totals.EstimatedCost, StringFormat={}{0:F4}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 缓存命中率 -->
                                <Grid Style="{StaticResource SettingsItemRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.SettingsStatsCacheRate}" Style="{StaticResource SettingsItemTitleStyle}" />
                                        <TextBlock Text="{DynamicResource Str.SettingsStatsCacheRateDesc}" Style="{StaticResource SettingsItemDescStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                               Text="{Binding UsageCacheRateDisplay}" />
                                </Grid>

                                <!-- 历史明细 -->
                                <TextBlock Text="{DynamicResource Str.SettingsStatsRecent}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,14,0,6" />
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" MaxHeight="240" Padding="6">
                                    <ListBox ItemsSource="{Binding UsageRecentView}"
                                             ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ModelId}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}" FontSize="11"
                                                                   Foreground="{DynamicResource TertiaryTextBrush}" Margin="10,0,0,0" />
                                                        <Border Background="{DynamicResource SelectedBackgroundBrush}" CornerRadius="5"
                                                                Padding="5,1" Margin="10,0,0,0"
                                                                Visibility="{Binding HasCacheData, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock FontSize="9" Foreground="{DynamicResource AccentBrush}">
                                                                <Run Text="缓存 " /><Run Text="{Binding CacheHitRate, StringFormat={}{0:F1}%, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding TotalTokens, Mode=OneWay}" /><Run Text=" tokens · ¥" /><Run Text="{Binding EstimatedCost, StringFormat={}{0:F4}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Tab: 关于与更新 ===== -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=About, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.SettingsAboutSectionTitle}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="GuideCraft · 引导式AI助手" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                                <TextBlock Margin="0,4,0,14" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="版本 v" /><Run Text="{Binding VersionText}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding IsCheckingUpdate, Converter={StaticResource TestTextConverter}, ConverterParameter=update}"
                                            Command="{Binding CheckUpdateCommand}"
                                            IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str.SettingsOpenRelease}"
                                            Command="{Binding OpenReleaseCommand}"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
