<Window x:Class="GuideCraft.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:GuideCraft.Utils"
        Title="{DynamicResource Str.SettingsTitle}"
        Width="560" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">

    <Border Background="{DynamicResource WindowBackgroundBrush}" Padding="24,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
            <StackPanel>
                <!-- ============ API Key 引导卡片 ============ -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.SettingsApiKeyTitle}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <!-- 提供方 -->
                        <TextBlock Text="{DynamicResource Str.SettingsProvider}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  Background="{DynamicResource InputBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource InputBorderBrush}"
                                  Padding="8,5" FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ProviderNameConverter}}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 模型 -->
                        <TextBlock Text="{DynamicResource Str.SettingsModel}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel}"
                                  DisplayMemberPath="Id"
                                  Background="{DynamicResource InputBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource InputBorderBrush}"
                                  Padding="8,5" FontSize="13" />

                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding KeyHintText}"
                                   LineHeight="20" />

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding ApiKeyPageLabel, StringFormat=打开 {0} 申请 →}"
                                Command="{Binding OpenApiKeyPageCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />

                        <!-- API Key 输入 -->
                        <TextBlock Text="{DynamicResource Str.SettingsApiKeyLabel}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,16,0,6" />
                        <PasswordBox utils:PasswordBoxHelper.BindPassword="True"
                                     utils:PasswordBoxHelper.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BasePasswordStyle}" />

                        <!-- 测试连接 -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding IsTesting, Converter={StaticResource TestTextConverter}, ConverterParameter=test}"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}" />
                            <TextBlock Text="{Binding TestResult}" FontSize="12" VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 偏好设置 ============ -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,14" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 语言 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Str.SettingsLanguage}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="Id"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource InputBorderBrush}"
                                      Padding="8,5" FontSize="13" />
                        </StackPanel>

                        <!-- 主题 -->
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{DynamicResource Str.SettingsTheme}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      DisplayMemberPath="Id"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource InputBorderBrush}"
                                      Padding="8,5" FontSize="13" />
                        </StackPanel>

                        <!-- 导航栏位置 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,12,0">
                            <TextBlock Text="{DynamicResource Str.SettingsSidebar}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding SidebarPositions}"
                                      SelectedItem="{Binding SelectedSidebar}"
                                      DisplayMemberPath="Id"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource InputBorderBrush}"
                                      Padding="8,5" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 关于 / 更新 ============ -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.SettingsAbout}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="{DynamicResource Str.SettingsVersion}" />
                            <Run Text="GuideCraft " />
                            <Run Text="v" /><Run Text="{Binding VersionText}" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding IsCheckingUpdate, Converter={StaticResource TestTextConverter}, ConverterParameter=update}"
                                    Command="{Binding CheckUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="⬇ 下载"
                                    Command="{Binding OpenReleaseCommand}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="12"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ============ 底部按钮 ============ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Str.SettingsCancel}"
                            IsCancel="True" Margin="0,0,10,0" Width="92" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Str.SettingsSave}"
                            IsDefault="True" Click="SaveButton_OnClick" Width="92" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
