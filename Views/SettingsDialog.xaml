<Window x:Class="GuideCraft.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:GuideCraft.Utils"
        Title="{DynamicResource Str.SettingsTitle}"
        Width="640" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">

    <Border Background="{DynamicResource WindowBackgroundBrush}" Padding="24,20">
        <StackPanel MaxHeight="720">

            <!-- ============ API Key 引导卡片 ============ -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.SettingsApiKeyTitle}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <!-- 提供方 -->
                    <TextBlock Text="{DynamicResource Str.SettingsProvider}" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,14,0,8" />
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton GroupName="Provider"
                                     Content="{DynamicResource Str.Provider.Qwen}"
                                     IsChecked="{Binding SelectedProvider, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Qwen, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <RadioButton GroupName="Provider"
                                     Content="{DynamicResource Str.Provider.DeepSeek}"
                                     IsChecked="{Binding SelectedProvider, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=DeepSeek, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- 模型 -->
                    <TextBlock Text="{DynamicResource Str.SettingsModel}" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,8" />
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton GroupName="Model" Content="qwen-plus"
                                     IsChecked="{Binding SelectedModel, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=qwen-plus, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton GroupName="Model" Content="qwen-turbo"
                                     IsChecked="{Binding SelectedModel, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=qwen-turbo, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton GroupName="Model" Content="qwen-max"
                                     IsChecked="{Binding SelectedModel, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=qwen-max, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton GroupName="Model" Content="qwen-flash"
                                     IsChecked="{Binding SelectedModel, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=qwen-flash, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton GroupName="Model" Content="deepseek-v4-flash"
                                     IsChecked="{Binding SelectedModel, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=deepseek-v4-flash, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton GroupName="Model" Content="deepseek-v4-pro"
                                     IsChecked="{Binding SelectedModel, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=deepseek-v4-pro, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>

                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding KeyHintText}"
                               LineHeight="20" />

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding ApiKeyPageLabel, StringFormat=打开 {0} 申请 →}"
                            Command="{Binding OpenApiKeyPageCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />

                    <!-- API Key 输入 -->
                    <TextBlock Text="{DynamicResource Str.SettingsApiKeyLabel}" FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,16,0,6" />
                    <PasswordBox utils:PasswordBoxHelper.BindPassword="True"
                                 utils:PasswordBoxHelper.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BasePasswordStyle}" />

                    <!-- 测试连接 -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding IsTesting, Converter={StaticResource TestTextConverter}, ConverterParameter=test}"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}" />
                        <TextBlock Text="{Binding TestResult}" FontSize="12" VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 偏好设置 ============ -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.SettingsLanguage}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <RadioButton GroupName="Language" Content="简体中文"
                                     IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=zh-CN, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <RadioButton GroupName="Language" Content="English"
                                     IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=en-US, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>

                    <TextBlock Text="{DynamicResource Str.SettingsTheme}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,14,0,8" />
                    <WrapPanel>
                        <RadioButton GroupName="Theme" Content="{DynamicResource Str.SettingsThemeLight}"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Light, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <RadioButton GroupName="Theme" Content="{DynamicResource Str.SettingsThemeDark}"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Dark, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>

                    <TextBlock Text="{DynamicResource Str.SettingsSidebar}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,14,0,8" />
                    <WrapPanel>
                        <RadioButton GroupName="Sidebar" Content="{DynamicResource Str.SettingsSidebarLeft}"
                                     IsChecked="{Binding SelectedSidebar, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Left, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <RadioButton GroupName="Sidebar" Content="{DynamicResource Str.SettingsSidebarRight}"
                                     IsChecked="{Binding SelectedSidebar, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Right, Mode=TwoWay}"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============ 关于 / 更新 ============ -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.SettingsAbout}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource Str.SettingsVersion}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text=": GuideCraft v" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding VersionText}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding IsCheckingUpdate, Converter={StaticResource TestTextConverter}, ConverterParameter=update}"
                                Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="⬇ 下载"
                                Command="{Binding OpenReleaseCommand}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" FontSize="12"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 底部按钮 ============ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Str.SettingsCancel}"
                        IsCancel="True" Margin="0,0,10,0" Width="92" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Str.SettingsSave}"
                        IsDefault="True" Click="SaveButton_OnClick" Width="92" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>