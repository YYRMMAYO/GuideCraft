<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 浅色主题 v2 ============ -->
    <Color x:Key="AccentColor">#4C6FFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D5CF0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2E4BD8" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F8" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#ECEDF1" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1F27" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5D6572" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9AA1AD" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D5D9E0" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#4C6FFF" />

    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="#4C6FFF" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiBubbleBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiBubbleTextBrush" Color="#1B1F27" />

    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EBEDF1" />

    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="CodeBorderBrush" Color="#E2E5EB" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#24292F" />
    <SolidColorBrush x:Key="InlineCodeBackgroundBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#C64756" />

    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EDEFF4" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#E3E9FF" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#C6CBD4" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#AEB4BF" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1FA971" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
</ResourceDictionary>
